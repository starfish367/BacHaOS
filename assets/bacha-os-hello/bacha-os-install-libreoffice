#!/usr/bin/env bash
# Privileged, user-triggered LibreOffice installation helper for BacHa OS Hello.
set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive

if [[ $(id -u) -ne 0 ]]; then
  printf '%s\n' 'FAILED|Cài LibreOffice cần quyền quản trị.'
  exit 1
fi

apt-get -o Acquire::Retries=3 update
apt-get -o Acquire::Retries=3 install -y --no-install-recommends libreoffice libreoffice-l10n-vi
update-desktop-database /usr/share/applications 2>/dev/null || true
printf '%s\n' 'INSTALLED|LibreOffice và gói tiếng Việt đã được cài.'
